[
 {
  "shot": 1,
  "k": 1,
  "text": "一辆开往大理的旅游大巴上，导游正在推销茶叶。",
  "wav": "tts_matcha/s01_01.wav",
  "dur": 4.808,
  "sr": 22050
 },
 {
  "shot": 1,
  "k": 2,
  "text": "后排一位游客悄悄按下了录音键。",
  "wav": "tts_matcha/s01_02.wav",
  "dur": 3.522,
  "sr": 22050
 },
 {
  "shot": 1,
  "k": 3,
  "text": "这段录音，接下来会去哪儿？",
  "wav": "tts_matcha/s01_03.wav",
  "dur": 2.703,
  "sr": 22050
 },
 {
  "shot": 1,
  "k": 4,
  "text": "又能帮到谁？",
  "wav": "tts_matcha/s01_04.wav",
  "dur": 1.332,
  "sr": 22050
 },
 {
  "shot": 2,
  "k": 1,
  "text": "云南是旅游大省，文旅部门一直在整治导游乱象和强制消费。",
  "wav": "tts_matcha/s02_01.wav",
  "dur": 6.213,
  "sr": 22050
 },
 {
  "shot": 2,
  "k": 2,
  "text": "二零二六年三月十五日起施行的《旅游投诉处理办法》规定：",
  "wav": "tts_matcha/s02_02.wav",
  "dur": 5.64,
  "sr": 22050
 },
 {
  "shot": 2,
  "k": 3,
  "text": "收到投诉，两个工作日内就要决定是否受理；",
  "wav": "tts_matcha/s02_03.wav",
  "dur": 4.337,
  "sr": 22050
 },
 {
  "shot": 2,
  "k": 4,
  "text": "投诉双方都要拿出证据。",
  "wav": "tts_matcha/s02_04.wav",
  "dur": 2.462,
  "sr": 22050
 },
 {
  "shot": 3,
  "k": 1,
  "text": "可录音没法一眼看完。",
  "wav": "tts_matcha/s03_01.wav",
  "dur": 2.378,
  "sr": 22050
 },
 {
  "shot": 3,
  "k": 2,
  "text": "一段一小时的大巴录音，靠人一句一句听写，往往要花好几倍的时间；",
  "wav": "tts_matcha/s03_02.wav",
  "dur": 6.605,
  "sr": 22050
 },
 {
  "shot": 3,
  "k": 3,
  "text": "还得找出关键的那几句，核对说了多少钱、是谁说的。",
  "wav": "tts_matcha/s03_03.wav",
  "dur": 4.957,
  "sr": 22050
 },
 {
  "shot": 4,
  "k": 1,
  "text": "这就是我们要做的项目：旅游投诉录音证据智能整理助手。",
  "wav": "tts_matcha/s04_01.wav",
  "dur": 5.15,
  "sr": 22050
 },
 {
  "shot": 4,
  "k": 2,
  "text": "它把录音变成一份核查初稿：",
  "wav": "tts_matcha/s04_02.wav",
  "dur": 2.917,
  "sr": 22050
 },
 {
  "shot": 4,
  "k": 3,
  "text": "谁在什么时候说了什么，哪几段可能有问题，提到了哪些金额和号码，一目了然。",
  "wav": "tts_matcha/s04_03.wav",
  "dur": 7.655,
  "sr": 22050
 },
 {
  "shot": 5,
  "k": 1,
  "text": "但是记住，助手只提示，不判定。",
  "wav": "tts_matcha/s05_01.wav",
  "dur": 3.218,
  "sr": 22050
 },
 {
  "shot": 5,
  "k": 2,
  "text": "初稿上的片段都标着疑似、待核查，最后一定由投诉处理人员亲自复核。",
  "wav": "tts_matcha/s05_02.wav",
  "dur": 7.068,
  "sr": 22050
 },
 {
  "shot": 6,
  "k": 1,
  "text": "为什么不直接丢给手机里的人工智能？",
  "wav": "tts_matcha/s06_01.wav",
  "dur": 3.238,
  "sr": 22050
 },
 {
  "shot": 6,
  "k": 2,
  "text": "因为投诉录音里有个人信息，不适合上传到公共大模型。",
  "wav": "tts_matcha/s06_02.wav",
  "dur": 5.448,
  "sr": 22050
 },
 {
  "shot": 6,
  "k": 3,
  "text": "我们的助手在本地运行，还要专门听懂云南的地名、店名和行话。",
  "wav": "tts_matcha/s06_03.wav",
  "dur": 5.992,
  "sr": 22050
 },
 {
  "shot": 7,
  "k": 1,
  "text": "整个助手就像一条流水线，一共八步：",
  "wav": "tts_matcha/s07_01.wav",
  "dur": 3.46,
  "sr": 22050
 },
 {
  "shot": 7,
  "k": 2,
  "text": "统一格式、降噪切段、转成文字、分清谁在说话、把数字和证号写规范、用深度学习模型给每句话分类、按时间截出证据片段，最后生成核查初稿。",
  "wav": "tts_matcha/s07_02.wav",
  "dur": 13.925,
  "sr": 22050
 },
 {
  "shot": 7,
  "k": 3,
  "text": "你们八个组，每组守一个工位。",
  "wav": "tts_matcha/s07_03.wav",
  "dur": 2.854,
  "sr": 22050
 },
 {
  "shot": 8,
  "k": 1,
  "text": "数据从哪儿来？",
  "wav": "tts_matcha/s08_01.wav",
  "dur": 1.53,
  "sr": 22050
 },
 {
  "shot": 8,
  "k": 2,
  "text": "我们不用任何真实投诉录音。",
  "wav": "tts_matcha/s08_02.wav",
  "dur": 2.615,
  "sr": 22050
 },
 {
  "shot": 8,
  "k": 3,
  "text": "每组按虚构剧本演情景剧，在安静、嘈杂教室、手机放口袋三种条件下各录一遍。",
  "wav": "tts_matcha/s08_03.wav",
  "dur": 7.916,
  "sr": 22050
 },
 {
  "shot": 8,
  "k": 4,
  "text": "全班七十二段录音放进同一个数据池，用同一份标准答案来测。",
  "wav": "tts_matcha/s08_04.wav",
  "dur": 6.075,
  "sr": 22050
 },
 {
  "shot": 9,
  "k": 1,
  "text": "怎么知道识别得准不准？",
  "wav": "tts_matcha/s09_01.wav",
  "dur": 2.008,
  "sr": 22050
 },
 {
  "shot": 9,
  "k": 2,
  "text": "用字错率：把识别结果和标准答案逐字对比，数出错字、漏字和多字，再除以总字数。",
  "wav": "tts_matcha/s09_02.wav",
  "dur": 8.096,
  "sr": 22050
 },
 {
  "shot": 9,
  "k": 3,
  "text": "比如雾隐行舟旅行社，被听成了雾影行走旅行社，七个字错了两个。",
  "wav": "tts_matcha/s09_03.wav",
  "dur": 6.569,
  "sr": 22050
 },
 {
  "shot": 9,
  "k": 4,
  "text": "改进前测一次，改进后再测一次，让数字说话。",
  "wav": "tts_matcha/s09_04.wav",
  "dur": 4.769,
  "sr": 22050
 },
 {
  "shot": 10,
  "k": 1,
  "text": "做这个项目，有四条规矩：",
  "wav": "tts_matcha/s10_01.wav",
  "dur": 2.616,
  "sr": 22050
 },
 {
  "shot": 10,
  "k": 2,
  "text": "剧本里的名字全部虚构；",
  "wav": "tts_matcha/s10_02.wav",
  "dur": 2.165,
  "sr": 22050
 },
 {
  "shot": 10,
  "k": 3,
  "text": "只写购物、费用、行程、服务态度这些商业纠纷；",
  "wav": "tts_matcha/s10_03.wav",
  "dur": 4.588,
  "sr": 22050
 },
 {
  "shot": 10,
  "k": 4,
  "text": "系统只标疑似，必须人工复核；",
  "wav": "tts_matcha/s10_04.wav",
  "dur": 3.012,
  "sr": 22050
 },
 {
  "shot": 10,
  "k": 5,
  "text": "录音前签同意书，不录任何真实个人信息。",
  "wav": "tts_matcha/s10_05.wav",
  "dur": 4.261,
  "sr": 22050
 },
 {
  "shot": 11,
  "k": 1,
  "text": "接下来十周：",
  "wav": "tts_matcha/s11_01.wav",
  "dur": 1.203,
  "sr": 22050
 },
 {
  "shot": 11,
  "k": 2,
  "text": "先跑通识别、学会算字错率；",
  "wav": "tts_matcha/s11_02.wav",
  "dur": 2.813,
  "sr": 22050
 },
 {
  "shot": 11,
  "k": 3,
  "text": "再学原理、做深度学习小实验；",
  "wav": "tts_matcha/s11_03.wav",
  "dur": 2.838,
  "sr": 22050
 },
 {
  "shot": 11,
  "k": 4,
  "text": "第五周写剧本、录音；",
  "wav": "tts_matcha/s11_04.wav",
  "dur": 1.982,
  "sr": 22050
 },
 {
  "shot": 11,
  "k": 5,
  "text": "第六到第八周各组专项改进；",
  "wav": "tts_matcha/s11_05.wav",
  "dur": 2.847,
  "sr": 22050
 },
 {
  "shot": 11,
  "k": 6,
  "text": "第九周把八个工位串起来；",
  "wav": "tts_matcha/s11_06.wav",
  "dur": 2.347,
  "sr": 22050
 },
 {
  "shot": 11,
  "k": 7,
  "text": "第十周上台演示。",
  "wav": "tts_matcha/s11_07.wav",
  "dur": 1.788,
  "sr": 22050
 },
 {
  "shot": 12,
  "k": 1,
  "text": "一段录音，从听不清、找不到，到有据可查。",
  "wav": "tts_matcha/s12_01.wav",
  "dur": 4.443,
  "sr": 22050
 },
 {
  "shot": 12,
  "k": 2,
  "text": "这个助手靠不靠谱，就看你们每一次录音、每一次测量。",
  "wav": "tts_matcha/s12_02.wav",
  "dur": 5.274,
  "sr": 22050
 },
 {
  "shot": 12,
  "k": 3,
  "text": "准备好了吗？我们开工！",
  "wav": "tts_matcha/s12_03.wav",
  "dur": 2.252,
  "sr": 22050
 }
]