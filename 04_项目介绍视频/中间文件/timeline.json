{
 "shots": [
  {
   "shot": 1,
   "start": 0.0,
   "dur": 14.915,
   "cues": [
    {
     "start": 0.7,
     "dur": 4.808,
     "text": "一辆开往大理的旅游大巴上，导游正在推销茶叶。"
    },
    {
     "start": 5.858,
     "dur": 3.522,
     "text": "后排一位游客悄悄按下了录音键。"
    },
    {
     "start": 9.73,
     "dur": 2.703,
     "text": "这段录音，接下来会去哪儿？"
    },
    {
     "start": 12.783,
     "dur": 1.332,
     "text": "又能帮到谁？"
    }
   ]
  },
  {
   "shot": 2,
   "start": 14.915,
   "dur": 21.202,
   "cues": [
    {
     "start": 0.7,
     "dur": 6.213,
     "text": "云南是旅游大省，文旅部门一直在整治导游乱象和强制消费。"
    },
    {
     "start": 7.263,
     "dur": 5.64,
     "text": "二零二六年三月十五日起施行的《旅游投诉处理办法》规定："
    },
    {
     "start": 13.253,
     "dur": 4.337,
     "text": "收到投诉，两个工作日内就要决定是否受理；"
    },
    {
     "start": 17.94,
     "dur": 2.462,
     "text": "投诉双方都要拿出证据。"
    }
   ]
  },
  {
   "shot": 3,
   "start": 36.117,
   "dur": 16.14,
   "cues": [
    {
     "start": 0.7,
     "dur": 2.378,
     "text": "可录音没法一眼看完。"
    },
    {
     "start": 3.428,
     "dur": 6.605,
     "text": "一段一小时的大巴录音，靠人一句一句听写，往往要花好几倍的时间；"
    },
    {
     "start": 10.383,
     "dur": 4.957,
     "text": "还得找出关键的那几句，核对说了多少钱、是谁说的。"
    }
   ]
  },
  {
   "shot": 4,
   "start": 52.257,
   "dur": 17.922,
   "cues": [
    {
     "start": 0.7,
     "dur": 5.15,
     "text": "这就是我们要做的项目：旅游投诉录音证据智能整理助手。"
    },
    {
     "start": 6.2,
     "dur": 2.917,
     "text": "它把录音变成一份核查初稿："
    },
    {
     "start": 9.467,
     "dur": 7.655,
     "text": "谁在什么时候说了什么，哪几段可能有问题，提到了哪些金额和号码，一目了然。"
    }
   ]
  },
  {
   "shot": 5,
   "start": 70.179,
   "dur": 12.136,
   "cues": [
    {
     "start": 0.7,
     "dur": 3.218,
     "text": "但是记住，助手只提示，不判定。"
    },
    {
     "start": 4.268,
     "dur": 7.068,
     "text": "初稿上的片段都标着疑似、待核查，最后一定由投诉处理人员亲自复核。"
    }
   ]
  },
  {
   "shot": 6,
   "start": 82.315,
   "dur": 16.878,
   "cues": [
    {
     "start": 0.7,
     "dur": 3.238,
     "text": "为什么不直接丢给手机里的人工智能？"
    },
    {
     "start": 4.288,
     "dur": 5.448,
     "text": "因为投诉录音里有个人信息，不适合上传到公共大模型。"
    },
    {
     "start": 10.086,
     "dur": 5.992,
     "text": "我们的助手在本地运行，还要专门听懂云南的地名、店名和行话。"
    }
   ]
  },
  {
   "shot": 7,
   "start": 99.193,
   "dur": 22.439,
   "cues": [
    {
     "start": 0.7,
     "dur": 3.46,
     "text": "整个助手就像一条流水线，一共八步："
    },
    {
     "start": 4.51,
     "dur": 13.925,
     "text": "统一格式、降噪切段、转成文字、分清谁在说话、把数字和证号写规范、用深度学习模型给每句话分类、按时间截出证据片段，最后生成核查初稿。"
    },
    {
     "start": 18.785,
     "dur": 2.854,
     "text": "你们八个组，每组守一个工位。"
    }
   ]
  },
  {
   "shot": 8,
   "start": 121.632,
   "dur": 20.686,
   "cues": [
    {
     "start": 0.7,
     "dur": 1.53,
     "text": "数据从哪儿来？"
    },
    {
     "start": 2.58,
     "dur": 2.615,
     "text": "我们不用任何真实投诉录音。"
    },
    {
     "start": 5.545,
     "dur": 7.916,
     "text": "每组按虚构剧本演情景剧，在安静、嘈杂教室、手机放口袋三种条件下各录一遍。"
    },
    {
     "start": 13.811,
     "dur": 6.075,
     "text": "全班七十二段录音放进同一个数据池，用同一份标准答案来测。"
    }
   ]
  },
  {
   "shot": 9,
   "start": 142.318,
   "dur": 23.992,
   "cues": [
    {
     "start": 0.7,
     "dur": 2.008,
     "text": "怎么知道识别得准不准？"
    },
    {
     "start": 3.058,
     "dur": 8.096,
     "text": "用字错率：把识别结果和标准答案逐字对比，数出错字、漏字和多字，再除以总字数。"
    },
    {
     "start": 11.504,
     "dur": 6.569,
     "text": "比如雾隐行舟旅行社，被听成了雾影行走旅行社，七个字错了两个。"
    },
    {
     "start": 18.423,
     "dur": 4.769,
     "text": "改进前测一次，改进后再测一次，让数字说话。"
    }
   ]
  },
  {
   "shot": 10,
   "start": 166.31,
   "dur": 19.542,
   "cues": [
    {
     "start": 0.7,
     "dur": 2.616,
     "text": "做这个项目，有四条规矩："
    },
    {
     "start": 3.666,
     "dur": 2.165,
     "text": "剧本里的名字全部虚构；"
    },
    {
     "start": 6.181,
     "dur": 4.588,
     "text": "只写购物、费用、行程、服务态度这些商业纠纷；"
    },
    {
     "start": 11.119,
     "dur": 3.012,
     "text": "系统只标疑似，必须人工复核；"
    },
    {
     "start": 14.481,
     "dur": 4.261,
     "text": "录音前签同意书，不录任何真实个人信息。"
    }
   ]
  },
  {
   "shot": 11,
   "start": 185.852,
   "dur": 19.418,
   "cues": [
    {
     "start": 0.7,
     "dur": 1.203,
     "text": "接下来十周："
    },
    {
     "start": 2.253,
     "dur": 2.813,
     "text": "先跑通识别、学会算字错率；"
    },
    {
     "start": 5.416,
     "dur": 2.838,
     "text": "再学原理、做深度学习小实验；"
    },
    {
     "start": 8.604,
     "dur": 1.982,
     "text": "第五周写剧本、录音；"
    },
    {
     "start": 10.936,
     "dur": 2.847,
     "text": "第六到第八周各组专项改进；"
    },
    {
     "start": 14.133,
     "dur": 2.347,
     "text": "第九周把八个工位串起来；"
    },
    {
     "start": 16.83,
     "dur": 1.788,
     "text": "第十周上台演示。"
    }
   ]
  },
  {
   "shot": 12,
   "start": 205.27,
   "dur": 16.569,
   "cues": [
    {
     "start": 0.7,
     "dur": 4.443,
     "text": "一段录音，从听不清、找不到，到有据可查。"
    },
    {
     "start": 5.493,
     "dur": 5.274,
     "text": "这个助手靠不靠谱，就看你们每一次录音、每一次测量。"
    },
    {
     "start": 11.117,
     "dur": 2.252,
     "text": "准备好了吗？我们开工！"
    }
   ]
  }
 ],
